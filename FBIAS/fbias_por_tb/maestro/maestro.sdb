								<value>1u</value>
							</var>
							<var>VDD
								<value>0</value>
							</var>
							<var>VDD_BOR
								<value>-500m</value>
							</var>
						</vars>
						<tooloptions>
							<option>cell
								<value>fbias_por_tb</value>
							</option>
							<option>lib
								<value>FBIAS</value>
							</option>
							<option>path
								<value>$AXL_SETUPDB_DIR/test_states</value>
							</option>
							<option>sim
								<value>spectre</value>
							</option>
