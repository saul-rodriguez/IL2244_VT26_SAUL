								<value>Interactive.76</value>
							</option>
							<option>view
								<value>config</value>
							</option>
						</tooloptions>
						<prerunscript>0</prerunscript>
						<outputs>
							<output>/POR_L
								<evalType>point</evalType>
							</output>
