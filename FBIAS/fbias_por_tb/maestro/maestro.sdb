								<value>FBIAS</value>
							</option>
							<option>sim
								<value>spectre</value>
							</option>
							<option>view
								<value>config</value>
							</option>
							<option>path
								<value>$AXL_SETUPDB_DIR/test_states</value>
							</option>
							<option>state
								<value>Interactive.72</value>
							</option>
						</tooloptions>
						<vars>
							<var>VDD_STEP
								<value>0</value>
							</var>
							<var>VDD_TR
								<value>1u</value>
							</var>
							<var>VDD
								<value>3.3</value>
							</var>
							<var>VDD_BOR
								<value>0</value>
							</var>
