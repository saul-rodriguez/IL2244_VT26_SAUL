.SUBCKT cpolyc MINUS PLUS SUB area=100p perimeter=40u
*.PININFO MINUS:B PLUS:B SUB:B
CC1 MINUS SUB $[CP]
CC0 MINUS PLUS $[CPOLYA] $P=(perimeter)*1e+6 $A=(area)*1e+12
.ENDS

