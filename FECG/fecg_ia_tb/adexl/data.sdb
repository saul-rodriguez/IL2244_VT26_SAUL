					<option>lib
						<value>FECG</value>
					</option>
					<option>path
						<value>$AXL_SETUPDB_DIR/test_states</value>
					</option>
					<option>sim
						<value>spectre</value>
					</option>
					<option>state
						<value>MC_active</value>
					</option>
					<option>view
						<value>config</value>
					</option>
				</tooloptions>
				<prerunscript>0</prerunscript>
				<origoptions>
					<option>cell
						<value>ecg_ia_tb</value>
					</option>
					<option>lib
						<value>ECG_IA</value>
					</option>
					<option>path
						<value>$AXL_SETUPDB_DIR/test_states</value>
